{
  "name": "just-markdown",
  "version": "0.3.0",
  "private": true,
  "description": "Just Markdown: Gold Edition - a lightweight local Markdown editor for Windows.",
  "license": "MIT",
  "author": "MattC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thaolin/just-markdown-gold.git"
  },
  "bugs": {
    "url": "https://github.com/Thaolin/just-markdown-gold/issues"
  },
  "homepage": "https://github.com/Thaolin/just-markdown-gold#readme",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "create:mac-icon": "node scripts/create-macos-icon.mjs",
    "start": "electron .",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run create:mac-icon && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage flatpak",
    "dist:all": "npm run build && npm run create:mac-icon && electron-builder --win nsis --mac dmg zip --linux AppImage flatpak"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "local.markdowneditor",
    "productName": "Just Markdown: Gold Edition",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown document",
          "icon": "build/icon.ico"
        },
        {
          "ext": "markdown",
          "name": "Markdown Document",
          "description": "Markdown document",
          "icon": "build/icon.ico"
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Markdown Document",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "flatpak"
      ],
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown document",
          "mimeType": "text/markdown"
        },
        {
          "ext": "markdown",
          "name": "Markdown Document",
          "description": "Markdown document",
          "mimeType": "text/markdown"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": null
    }
  }
}
